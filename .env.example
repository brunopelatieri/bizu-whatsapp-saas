# Copie para .env.local (ignorado pelo git). Só este arquivo é versionado, com
# valores de exemplo. Tudo é validado em src/lib/env.ts na inicialização.
# Variáveis VITE_* vão para o navegador: só valores públicos.

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
# Porta do servidor único em produção (em dev o Vite usa 5173).
PORT=3000
# URL pública do app: base dos links de e-mail, cookies e origens confiáveis.
APP_URL=http://localhost:5173
# Quantidade de reverse proxies confiáveis na frente do app. 0 sem proxy; 1 atrás de um.
TRUSTED_PROXY_HOPS=0
# Nome exibido no navegador (público).
VITE_APP_NAME=Bizu SaaS

# --- Postgres (Drizzle) ------------------------------------------------------
# Porta 15437: mapeamento do docker-compose (evita conflito no Windows).
# Os papéis são criados por docker/postgres/init.sql.
# Runtime: bizu_app, sem BYPASSRLS (o Row Level Security vale para ele).
DATABASE_URL=postgresql://bizu_app:bizu_app@localhost:15437/bizu
# Migrations, seed e instalação da fila: bizu_owner, dono das tabelas.
DIRECT_URL=postgresql://bizu_owner:bizu_owner@localhost:15437/bizu
# Em pooler no modo transaction (PgBouncer), acrescente ?prepare=false à DATABASE_URL.
# Tempo real da caixa de entrada: uma conexão LISTEN por processo web (padrão: DATABASE_URL).
# Precisa ser conexão direta ou pooler em modo sessão: em modo transaction o LISTEN não recebe
# nada. Com DATABASE_URL num pooler transaction, aponte esta para o Postgres direto (bizu_app).
REALTIME_DATABASE_URL=

# --- Segredos (gere valores novos; em produção os de exemplo são recusados) ----
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-better-auth-secret-with-32-bytes
# openssl rand -base64 32 (32 bytes em base64; cifra credenciais de provedores por tenant)
CREDENTIALS_ENCRYPTION_KEY=Y2hhbmdlLW1lLWNyZWRlbnRpYWxzLWtleS0zMmJ5dGU=
# Só durante a rotação da chave acima (docs/context/tech/26-seguranca.md).
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
CREDENTIALS_KEY_VERSION=1
# openssl rand -hex 16 (hash de IP no log de auditoria)
AUDIT_SALT=change-me-audit-salt

# --- E-mail ------------------------------------------------------------------
# true: o cadastro só entra depois do link de /verificar-email. false (padrão): entra direto;
# o login logo após o cadastro revela se o e-mail já tinha conta (docs/context/tech/08-auth.md).
EMAIL_VERIFICATION_REQUIRED=false
# smtp | resend | memory (memory: só testes, nada é enviado)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Bizu SaaS <no-reply@localhost>"
EMAIL_REPLY_TO=
# Mailpit do docker-compose: captura tudo em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Só com EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Jobs e rate limit -------------------------------------------------------
# inline (fila no mesmo processo) | worker (só workers) | off (só enfileira)
JOBS_MODE=inline
# memory (só desenvolvimento) | postgres (obrigatório em produção; tabela rate_limit_bucket)
RATE_LIMIT_STORE=memory

# --- Bloqueio de login por tentativas ----------------------------------------
# O que fica bloqueado depois de LOGIN_MAX_ATTEMPTS senhas erradas:
#   email    (padrão) o e-mail, venha de onde vier; segura ataque distribuído, mas um
#            terceiro consegue bloquear a conta (o dono sai redefinindo a senha)
#   email_ip o par e-mail e IP; o dono nunca fica trancado por causa de outro IP
#   off      nada; fica só o limite por IP
LOGIN_LOCKOUT_SCOPE=email
# Falhas, dentro da janela, que abrem o bloqueio (1 a 100).
LOGIN_MAX_ATTEMPTS=5
# Minutos em que as falhas se somam (1 a 1440).
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# Minutos de bloqueio (1 a 1440).
LOGIN_LOCKOUT_MINUTES=15

# --- Verificação de telefone -------------------------------------------------
# true (padrão): a conta com WhatsApp pendente só vê a tela "Confirme seu WhatsApp" até confirmar
# (a API responde 403 PHONE_UNVERIFIED). false: entra com um aviso; o vínculo automático das
# conversas continua esperando a confirmação. O link sai nos dois modos.
PHONE_VERIFICATION_REQUIRED=true
# Minutos de validade do link de verificação enviado ao número (5 a 1440).
PHONE_VERIFICATION_TTL_MINUTES=30
# Ordem dos tipos de canal que enviam o link (whatsapp_cloud, whatsapp_qr). Cada pedido sai pelos
# números conectados do responsável: a plataforma ou a organização. Cloud precisa do modelo de
# verificação escolhido no número. Vazio: nenhum envio, todo pedido espera a liberação à mão.
PHONE_VERIFICATION_CHANNELS=

# --- Pagamentos (módulos; vazio = só planos gratuitos) -----------------------
# Lista separada por vírgula com os módulos ativos de src/lib/payments/providers/.
PAYMENT_PROVIDERS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Canais de mensagem (módulos; vazio = sem WhatsApp) ----------------------
# Lista separada por vírgula com os módulos ativos de src/lib/channels/providers/:
# whatsapp_cloud (Cloud API da Meta; as credenciais são de cada canal, sem variável) e
# whatsapp_qr (Evolution Go, QR Code). Um id sem módulo derruba a subida.
CHANNEL_PROVIDERS=
# Dias que o aviso de canal já tratado (`channel_event`, com telefone e texto do provedor) fica
# guardado antes do `maintenance.prune` apagar. 1 a 365; padrão 30 (docs/context/lgpd.md).
# CHANNEL_EVENT_RETENTION_DAYS=30
# --- Retenção de mensagens (bloco R; docs/context/tech/30-caixa-de-entrada.md) ---
# Desligada no desenvolvimento: nada é apagado. Ligada (true), o job `inbox.retention` apaga, por
# organização e tipo de canal, mensagens antigas e acima do teto (e o arquivo da mensagem).
MESSAGE_RETENTION_ENABLED=false
# Padrões por tipo de canal; o proprietário da plataforma ajusta cada organização em /admin.
# Ausente ou 0 = sem limite nessa dimensão. Favoritas não são apagadas, só rebaixadas acima do teto.
MESSAGE_RETENTION_WHATSAPP_QR_MAX_MESSAGES=5000
MESSAGE_RETENTION_WHATSAPP_QR_DAYS=90
MESSAGE_RETENTION_WHATSAPP_QR_MAX_FAVORITES=200
MESSAGE_RETENTION_WHATSAPP_CLOUD_MAX_MESSAGES=5000
MESSAGE_RETENTION_WHATSAPP_CLOUD_DAYS=90
MESSAGE_RETENTION_WHATSAPP_CLOUD_MAX_FAVORITES=200
# Piso: nenhuma mensagem mais nova que isto (horas, 24 a 8760) é apagada, qualquer que seja a política.
MESSAGE_RETENTION_MIN_AGE_HOURS=72
# Teto de linhas por fase, escopo e execução (1 a 100000).
MESSAGE_RETENTION_BATCH_LIMIT=5000
# Obrigatórias com whatsapp_qr. O servidor Evolution é um só, da plataforma: o tenant nunca
# informa a URL. A chave global começa com `change-me` no exemplo e é recusada em produção.
# EVOLUTION_API_URL=http://localhost:4000
# EVOLUTION_GLOBAL_API_KEY=change-me-evolution-global-key
# Endereço do bizu que o servidor Evolution alcança (padrão: APP_URL): webhook e anexo de saída do atendimento.
# EVOLUTION_WEBHOOK_PUBLIC_URL=
# Prefixo do nome das instâncias e teto de instâncias no servidor, somando todos os escopos.
# EVOLUTION_INSTANCE_PREFIX=bizu
# EVOLUTION_MAX_INSTANCES_TOTAL=20
# Origens de onde o job aceita baixar `mediaUrl` pré-assinada (S3 privado onde a Evolution
# grava). Vazio = só base64. Ex.: https://s3.exemplo.com
# EVOLUTION_MEDIA_ORIGINS=
# EVOLUTION_REQUEST_TIMEOUT_MS=15000
# EVOLUTION_MEDIA_TIMEOUT_MS=60000

# --- Arquivos (módulo) -------------------------------------------------------
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Teto de um upload, em MB (1 a 100). Vale também como limite de corpo da rota.
MAX_UPLOAD_MB=10
# Teto da foto de perfil da equipe, em KB (16 a 10240; a tela recorta 256 px antes de enviar).
AVATAR_MAX_KB=1024

# --- Segurança, seed e observabilidade ---------------------------------------
# true: a CSP só relata violações em /api/csp-report. false: o navegador bloqueia.
CSP_REPORT_ONLY=true
# Senha única dos usuários do seed (`npm run db:seed`): 10 a 128 caracteres, com maiúscula,
# minúscula, número e um especial de !@#$%^&*()_+-=[]{}:;,.?/~. Só para dev:
# troque-a se o banco for acessível de fora. SEED_ALLOW_PRODUCTION=1 libera o seed em produção,
# onde este valor de exemplo é recusado.
SEED_PASSWORD=Bizu-seed-2026!
SEED_ALLOW_PRODUCTION=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Opcional: com o DSN, os erros de logError vão ao Sentry (src/lib/monitoring/sentry). Sem ele, nada é carregado.
SENTRY_DSN=

# --- Backup opcional (perfil `backup` do docker-compose.yml) ------------------
# Só vale para `docker compose --profile backup up -d backup`. A chave é a PÚBLICA do `age`
# (age-keygen); guarde a privada fora do servidor. O usuário precisa atravessar o RLS.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_PGUSER=postgres
# BACKUP_PGPASSWORD=postgres
# BACKUP_PGDATABASE=bizu
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
